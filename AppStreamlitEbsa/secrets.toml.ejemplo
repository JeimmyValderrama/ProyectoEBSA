# Usuarios de la página. Copiar este archivo como .streamlit\secrets.toml (en la carpeta
# desde la que se lanza la página, Pipeline_Ebsa) y cambiar las claves. Ese archivo NO va a Git.
# vistas posibles: "Comercial", "Soporte", "Administrador del modelo"
#   comercial -> solo Comercial
#   soporte   -> Soporte y Comercial
#   admin     -> todo

[usuarios.comercial]
nombre = "Comercial"
clave = "CAMBIAR"
vistas = ["Comercial"]

[usuarios.soporte]
nombre = "Soporte"
clave = "CAMBIAR"
vistas = ["Comercial", "Soporte"]

[usuarios.admin]
nombre = "Administrador del modelo"
clave = "CAMBIAR"
vistas = ["Comercial", "Soporte", "Administrador del modelo"]
